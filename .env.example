# ============================================================================
# Greenscape Pro — site-walk proposal agent
# Copy to .env.local and fill in. Every LLM call is cost-audited; the app is
# server-only (service role never reaches the browser).
# ============================================================================

# --- Supabase (Project Settings -> API in the Supabase dashboard) -----------

# Project URL for the database + storage.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable/anon key. Optional today: the app talks to Postgres only through
# the service-role server client and RLS is deny-all.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret server key — bypasses RLS. Server-side only, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers -----------------------------------------------------------

# Sonnet extraction + narrative, Haiku classification. Get it at console.anthropic.com.
ANTHROPIC_API_KEY=
# Whisper transcription + catalog embeddings. Get it at platform.openai.com/api-keys.
OPENAI_API_KEY=

# --- Dispatch: email (Resend, with the PDF attached) -------------------------

# API key from resend.com/api-keys.
RESEND_API_KEY=

# --- Dispatch: SMS (Twilio) ---------------------------------------------------

# Account SID from console.twilio.com.
TWILIO_ACCOUNT_SID=
# Auth token from console.twilio.com (same page as the SID).
TWILIO_AUTH_TOKEN=
# The Twilio number sends come from — buy one in the console first.
TWILIO_FROM_NUMBER=

# --- Dispatch: Slack (internal visibility, not the customer) ------------------

# Incoming webhook for the internal channel: Slack -> Create app -> Incoming Webhooks.
SLACK_WEBHOOK_URL=

# --- Dispatch: Stripe (50% deposit payment link) ------------------------------

# Secret key from Stripe Dashboard -> Developers -> API keys (sk_...).
STRIPE_SECRET_KEY=

# --- Dispatch: GHL CRM (GoHighLevel API v2) -----------------------------------

# http = real API (unverified — see src/lib/integrations/ghl.ts), mock = default.
GHL_MODE=mock
# API key from GHL: Settings -> API (or the marketplace app credentials).
GHL_API_KEY=
# The GHL sub-account (location) the contact/opportunity belong to.
GHL_LOCATION_ID=

# --- App ----------------------------------------------------------------------

# Absolute base URL used in outbound proposal links (email, SMS, GHL).
APP_URL=http://localhost:3000

# --- Demo auth (shared-password gate on /new and /proposals) ------------------

# The single shared password reviewers enter at /login. Demo scope only — one
# password for everyone, no user accounts.
DEMO_PASSWORD=
# HMAC key that signs the 7-day session cookie. Generate with: openssl rand -hex 32.
# Rotating it invalidates every outstanding session.
SESSION_SECRET=

# --- Secondary / optional -----------------------------------------------------

# From address for proposal emails (must be a verified Resend domain).
EMAIL_FROM=Greenscape Pro <proposals@greenscapepro.com>
# Fallback deposit link on /p/[token] when no Stripe link has been generated.
NEXT_PUBLIC_STRIPE_DEPOSIT_LINK=
# GHL pipeline/stage the opportunity is created in (http mode only).
GHL_PIPELINE_ID=
GHL_STAGE_ID=
# Override only for self-hosted GHL-compatible APIs.
GHL_API_BASE=https://services.leadconnectorhq.com
