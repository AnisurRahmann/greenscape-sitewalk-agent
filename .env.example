# Supabase project for this repo (Project Settings -> API).
# The publishable/anon URL is safe to expose; the service role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — bypasses RLS. Server-side only, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key used by scripts/embed-catalog.ts (text-embedding-3-small).
OPENAI_API_KEY=

# Anthropic API key for the scope-extraction and narrative agents.
ANTHROPIC_API_KEY=

# --- Dispatch (v0.12.0) ------------------------------------------------------
# Resend — proposal email with PDF attachment
RESEND_API_KEY=
EMAIL_FROM=Greenscape Pro <proposals@greenscapepro.com>

# Twilio — SMS with the proposal link
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Slack — internal approval visibility (not customer-facing)
SLACK_WEBHOOK_URL=

# Stripe — payment links for the 50% deposit
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_DEPOSIT_LINK=

# GHL integration: GHL_MODE=http|mock (default mock; see src/lib/integrations/ghl.ts)
GHL_MODE=mock
GHL_API_KEY=
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_PIPELINE_ID=
GHL_STAGE_ID=

# Absolute base URL used in outbound links
NEXT_PUBLIC_APP_URL=http://localhost:3000
