# Supabase project for this repo (Project Settings -> API).
# The publishable/anon URL is safe to expose; the service role key is NOT.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key — bypasses RLS. Server-side only, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key used by scripts/embed-catalog.ts (text-embedding-3-small).
OPENAI_API_KEY=
